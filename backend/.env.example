# =========================================================
# UniAssist AI - environment configuration
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env - only .env.example.
# =========================================================

# --- OpenRouter (LLM) ---------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_model_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Qdrant (vector database) -------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=university_documents

# --- Embedding model (BGE-M3) -------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
MODEL_CACHE_DIR=D:/AI_Models
EMBEDDING_DIMENSION=1024

# --- Chunking (character-based, not token-based) ------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ------------------------------------------------------------
DENSE_TOP_K=10
BM25_TOP_K=10
RRF_K=60
FINAL_TOP_K=5
ENABLE_RERANKER=false

# --- Chat API -------------------------------------------------------------
RAG_MAX_QUESTION_LENGTH=1000
